# Copy this file to ".env" and fill in your values. Never commit ".env".
# Without a real key the project runs in DEMO mode (rule-based, no API calls).
GROQ_API_KEY=your_groq_api_key
# Example model id (check https://console.groq.com/docs/models for current ones):
# GROQ_MODEL=llama-3.3-70b-versatile
GROQ_MODEL=your_supported_groq_model
